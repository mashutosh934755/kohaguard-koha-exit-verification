# KohaGuard example configuration — copy to .env and edit locally.
# NEVER commit a real .env file.

KOHAGUARD_BIND=0.0.0.0
KOHAGUARD_PORT=8096
KOHAGUARD_ANALYTICS_DB=/opt/kohaguard/kohaguard_analytics.db

# Koha MariaDB/MySQL connection
KOHA_DB_HOST=127.0.0.1
KOHA_DB_PORT=3306
KOHA_DB_NAME=koha_yourinstance
KOHA_DB_USER=koha_yourinstance
KOHA_DB_PASSWORD=CHANGE_ME

# Optional UI branding
LIBRARY_NAME=Your University Library

# Development-only CORS. Restrict this in production.
CORS_ORIGIN=*
